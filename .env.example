# 复制成 .env.local 后按需填写（.env.local 已被 .gitignore 忽略，不会提交）
# 所有 VITE_ 变量都是「构建时」注入的，改了要重新 build 才生效。

# ── 词库数据源（可选）──────────────────────────────
# 不填则使用原作者的公开只读词库。换用自己的 Supabase 时填写这两项，
# 并且需要在新实例里建好 chuzhong / gaozhong / cet4 / cet6 / kaoyan / toefl / sat 七张表。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── 反馈表单（默认关闭）────────────────────────────
# 默认 false：设置面板里不显示反馈表单，访客数据不会写进任何非本项目的数据库。
# 自己建好 Supabase 的 user-feedback 表并希望收集反馈时，改成 true。
VITE_FEEDBACK_ENABLED=false

# ── Cloudflare Web Analytics（默认关闭）────────────
# 留空则不加载任何统计脚本。要统计就填自己 Cloudflare 账号里的 beacon token
# （控制台 → Web Analytics → 添加站点后给出的 JS snippet 里的 token）。
VITE_CF_BEACON_TOKEN=
